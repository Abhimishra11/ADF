{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "abhi-adf2"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureBlobStorage2_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage2'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"LS_NEW_OnPrimes_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_NEW_OnPrimes'"
		},
		"LS_SQL_Server_Cloud_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_SQL_Server_Cloud'",
			"defaultValue": "integrated security=False;Data Source=abhi-sql-server.database.windows.net;Initial Catalog=abhi-db;User ID=abhishek"
		},
		"link_service_OnPrimes_new_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'link_service_OnPrimes_new'"
		},
		"link_service_jul_24_blob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'link_service_jul_24_blob'"
		},
		"link_service_july_24_sqlserver_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'link_service_july_24_sqlserver'"
		},
		"link_service_old_sqlserver_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'link_service_old_sqlserver'"
		},
		"ls_OnPremes_SqlServer_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_OnPremes_SqlServer'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://abhidatalake1.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://Abhi-Key-Vault3.vault.azure.net/"
		},
		"link_service_old_sqlserver_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "abhi-sql-server.database.windows.net"
		},
		"link_service_old_sqlserver_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "abhi-sqldb"
		},
		"link_service_old_sqlserver_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "abhi"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "abhi-adf2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureBlobStorage2_connectionString": {
						"value": "[parameters('AzureBlobStorage2_connectionString')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"link_service_jul_24_blob_connectionString": {
						"value": "[parameters('link_service_jul_24_blob_connectionString')]"
					},
					"link_service_july_24_sqlserver_connectionString": {
						"value": "[parameters('link_service_july_24_sqlserver_connectionString')]"
					},
					"link_service_old_sqlserver_password": {
						"value": "[parameters('link_service_old_sqlserver_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"link_service_old_sqlserver_properties_typeProperties_server": {
						"value": "[parameters('link_service_old_sqlserver_properties_typeProperties_server')]"
					},
					"link_service_old_sqlserver_properties_typeProperties_database": {
						"value": "[parameters('link_service_old_sqlserver_properties_typeProperties_database')]"
					},
					"link_service_old_sqlserver_properties_typeProperties_userName": {
						"value": "[parameters('link_service_old_sqlserver_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "abhi-adf2_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'abhi-adf2_ArmTemplate_0')]"
			]
		},
		{
			"name": "abhi-adf2_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_NEW_OnPrimes_connectionString": {
						"value": "[parameters('LS_NEW_OnPrimes_connectionString')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'abhi-adf2_ArmTemplate_1')]"
			]
		},
		{
			"name": "abhi-adf2_ArmTemplate_3",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_3.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_Server_Cloud_connectionString": {
						"value": "[parameters('LS_SQL_Server_Cloud_connectionString')]"
					},
					"link_service_OnPrimes_new_connectionString": {
						"value": "[parameters('link_service_OnPrimes_new_connectionString')]"
					},
					"ls_OnPremes_SqlServer_connectionString": {
						"value": "[parameters('ls_OnPremes_SqlServer_connectionString')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'abhi-adf2_ArmTemplate_2')]"
			]
		},
		{
			"name": "abhi-adf2_ArmTemplate_4",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_4.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'abhi-adf2_ArmTemplate_3')]"
			]
		}
	]
}